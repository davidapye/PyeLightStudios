rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.admin == true;
    }

    match /galleries/{path=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /thumbs/{path=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /previews/{path=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /zips/{path=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
